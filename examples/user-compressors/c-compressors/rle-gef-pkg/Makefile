# BitBench package `rle_gef` (RLE-GEF); generated by scripts/make_thesis_packages.py
CC      ?= cc
CFLAGS  ?= -O3 -std=c11 -Wall -Wextra
LDLIBS  ?= -lm

codec: src/main.c src/rle_gef.c $(wildcard src/*.h)
	$(CC) $(CFLAGS) -Isrc -o $@ src/main.c src/rle_gef.c $(LDLIBS)

selftest: src/selftest.c src/rle_gef.c $(wildcard src/*.h)
	$(CC) $(CFLAGS) -Isrc -o $@ src/selftest.c src/rle_gef.c $(LDLIBS)

clean:
	rm -f codec selftest

.PHONY: clean
