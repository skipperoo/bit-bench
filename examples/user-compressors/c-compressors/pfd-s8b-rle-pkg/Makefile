# BitBench package `pfd_s8b_rle` (PFD-S8b-RLE); generated by scripts/make_thesis_packages.py
CC      ?= cc
CFLAGS  ?= -O3 -std=c11 -Wall -Wextra
LDLIBS  ?= -lm

codec: src/main.c src/pfordelta.c $(wildcard src/*.h)
	$(CC) $(CFLAGS) -Isrc -o $@ src/main.c src/pfordelta.c $(LDLIBS)

selftest: src/selftest.c src/pfordelta.c $(wildcard src/*.h)
	$(CC) $(CFLAGS) -Isrc -o $@ src/selftest.c src/pfordelta.c $(LDLIBS)

clean:
	rm -f codec selftest

.PHONY: clean
