# BitBench package `dpcm_range` (DPCM-Range); generated by scripts/make_thesis_packages.py
CC      ?= cc
CFLAGS  ?= -O3 -std=c11 -Wall -Wextra
LDLIBS  ?= -lm

codec: src/main.c src/dpcm_range.c $(wildcard src/*.h)
	$(CC) $(CFLAGS) -Isrc -o $@ src/main.c src/dpcm_range.c $(LDLIBS)

selftest: src/selftest.c src/dpcm_range.c $(wildcard src/*.h)
	$(CC) $(CFLAGS) -Isrc -o $@ src/selftest.c src/dpcm_range.c $(LDLIBS)

clean:
	rm -f codec selftest

.PHONY: clean
